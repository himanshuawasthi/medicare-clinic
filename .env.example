# Copy to .env.local and fill in values from: supabase start
# NEVER commit .env.local — it is in .gitignore

# Supabase (anon key only — service-role key stays server-side)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Do NOT add SUPABASE_SERVICE_ROLE_KEY here. It must never reach the browser.